# Local development only. Never commit real keys.
AIRPG_DATABASE_URL=postgresql+psycopg://airpg:airpg@localhost/airpg
AIRPG_LLM_MODEL=google:gemini-3.5-flash
GEMINI_API_KEY=
# Optional tier overrides inherit AIRPG_LLM_MODEL when omitted.
# AIRPG_FAST_MODEL=google:gemini-3.5-flash
# AIRPG_QUALITY_MODEL=openai-responses:gpt-5-mini
# OPENAI_API_KEY=

# Production authentication: pre-register identities with `ai-rpg auth register`.
# AIRPG_AUTH_ISSUER=https://identity.example/realm
# AIRPG_AUTH_AUDIENCE=ai-rpg-api
# AIRPG_AUTH_ALLOWED_ALGORITHMS=RS256
# Browser login (set both; otherwise only Bearer authentication is enabled).
# AIRPG_AUTH_CLIENT_ID=ai-rpg-browser
# AIRPG_AUTH_CLIENT_SECRET=
# AIRPG_AUTH_APP_ORIGIN=https://game.example
# Local OIDC demonstration only; never enable for a public deployment.
# AIRPG_AUTH_ALLOW_INSECURE_LOOPBACK=false

# Local port override when another application uses 8000.
# AIRPG_PORT=18769
# Explicit opt-in for verified OIDC self-registration (never for public dev-principal).
# AIRPG_REGISTRATION_ENABLED=false
# Comma-separated internal principal UUIDs. Never OIDC subjects.
# AIRPG_ADMIN_PRINCIPAL_IDS=
# Limits apply per UTC day; retries of the same accepted operation are not charged twice.
# AIRPG_DAILY_TURN_LIMIT=100
# AIRPG_DAILY_STORY_LIMIT=10
# AIRPG_DAILY_STORY_VALIDATION_LIMIT=50
# AIRPG_DAILY_AUTHORING_JOB_LIMIT=20
# AIRPG_DAILY_GAME_LLM_LIMIT=300
# AIRPG_DAILY_AUTHORING_LLM_LIMIT=100
# AIRPG_DAILY_GLOBAL_LLM_LIMIT=5000
# AIRPG_CONCURRENT_TURN_LIMIT=3
# AIRPG_CONCURRENT_AUTHORING_JOB_LIMIT=2
# AIRPG_BACKGROUND_MODEL=google:gemini-3.5-flash
# AIRPG_AUTHORING_TIMEOUT_SECONDS=60
# AIRPG_AUTHORING_LEASE_SECONDS=90
# AIRPG_AUTHORING_MAX_PROMPT_BYTES=128000
# AIRPG_AUTHORING_MAX_OUTPUT_TOKENS=8192
# AIRPG_AUTHORING_MAX_TOTAL_TOKENS=24000
# AIRPG_AUTHORING_MAX_RUNNING=4
# Manual maintenance only; no automatic cleanup. The CLI defaults to dry-run.
# AIRPG_DRAFT_HISTORY_RETENTION_DAYS=30
# AIRPG_DRAFT_HISTORY_PRUNE_BATCH_SIZE=100

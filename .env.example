# Local development only. Never commit real keys.
AIRPG_DATABASE_URL=postgresql+psycopg://airpg:airpg@localhost/airpg
AIRPG_LLM_MODEL=google:gemini-3.5-flash
GEMINI_API_KEY=
# Optional tier overrides inherit AIRPG_LLM_MODEL when omitted.
# AIRPG_FAST_MODEL=google:gemini-3.5-flash
# AIRPG_QUALITY_MODEL=openai-responses:gpt-5-mini
# OPENAI_API_KEY=

# Production authentication: pre-register identities with `ai-rpg auth register`.
# AIRPG_AUTH_ISSUER=https://identity.example/realm
# AIRPG_AUTH_AUDIENCE=ai-rpg-api
# AIRPG_AUTH_ALLOWED_ALGORITHMS=RS256
# Browser login (set both; otherwise only Bearer authentication is enabled).
# AIRPG_AUTH_CLIENT_ID=ai-rpg-browser
# AIRPG_AUTH_CLIENT_SECRET=
# AIRPG_AUTH_APP_ORIGIN=https://game.example
# Local OIDC demonstration only; never enable for a public deployment.
# AIRPG_AUTH_ALLOW_INSECURE_LOOPBACK=false
